---
const cartel = ['Carne de ternera', 'Novillito', 'Pollo', 'Molleja', 'Chorizo casero', 'Bondiola', 'Pechito'];
---

<section class="local" id="local" aria-labelledby="local-title">
  <figure class="foto" data-reveal>
    <img src="/img/local.jpg" width="387" height="405" loading="lazy" alt="Interior de Carnicería Claudio: heladeras exhibidoras con cortes, banderas argentinas colgadas y carteles de precios" />
  </figure>

  <div class="texto">
    <h2 id="local-title" data-reveal>Un local impecable</h2>
    <p class="lead" data-reveal style="--i: 1">
      Heladeras a la vista, banderas en el techo y el mostrador limpio todo el día. En el cartel de la entrada dice "la mejor atención e higiene", y lo cumplimos.
    </p>
    <div class="cartel" data-reveal style="--i: 2">
      <p>Lo que dice el cartel de la fachada</p>
      <ul>
        {cartel.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .local {
    background: var(--blue);
    color: var(--on-blue);
    display: grid;
    gap: 2.5rem;
    padding: var(--section) var(--margin);
  }
  .foto { aspect-ratio: 4 / 5; overflow: hidden; max-width: 30rem; }
  .foto img { width: 100%; height: 100%; object-fit: cover; }
  @media (prefers-reduced-motion: no-preference) {
    .foto img { animation: drift 18s ease-in-out infinite alternate; }
  }
  @keyframes drift { from { transform: scale(1.02); } to { transform: scale(1.1) translateY(-2%); } }

  .texto { display: flex; flex-direction: column; gap: 2rem; }
  h2 { font-size: var(--step-head); }
  .lead { font-size: var(--step-lead); line-height: 1.35; max-width: 32ch; }
  .cartel { background: var(--blue-deep); padding: 1.5rem; }
  .cartel p { font-weight: 600; color: var(--celeste); }
  .cartel ul { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; font-size: var(--step-lead); font-weight: 800; letter-spacing: -0.03em; }

  @media (min-width: 64rem) {
    .local { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(3rem, 6vw, 7rem); align-items: center; }
    .foto { justify-self: end; width: 100%; }
  }
</style>
