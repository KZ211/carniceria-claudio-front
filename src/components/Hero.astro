---
import { site, waLink } from '../data/site';
import { tornPath } from '../lib/torn';

const rows = [
  { label: 'Dirección', value: `${site.address}, ${site.corner}` },
  { label: 'Barrio', value: 'Presidente Derqui' },
  { label: 'WhatsApp', value: site.phoneLabel },
  { label: 'Pago', value: 'Todas las tarjetas' },
];

const torn = tornPath({ teeth: 36, depth: 10 });
---

<header class="hero">
  <div class="slot" aria-hidden="true"></div>
  <div class="feed">
    <article class="ticket" style={`clip-path: ${torn}`}>
      <div class="top">
        <img class="logo" src="/img/logo.png" width="383" height="383" alt="Logo de Carnicería Claudio: una vaca blanca sobre un círculo rojo" />
        <nav aria-label="Secciones">
          <a href="#cortes">Cortes</a>
          <a href="#como-pedir">Cómo pedir</a>
          <a href="#local">El local</a>
          <a href="#visita">Horarios</a>
        </nav>
      </div>

      <div class="body">
        <h1>Carnicería Claudio</h1>
        <p class="statement">
          Vaca, cerdo, pollo, embutidos caseros y achuras, al peso exacto. Pedí por WhatsApp y pasá a retirar.
        </p>
        <div class="actions">
          <a class="btn" href={waLink('¡Hola Claudio! Quería hacer un pedido.')} target="_blank" rel="noopener">
            Pedir por WhatsApp
          </a>
          <a class="link" href="#cortes">Armar mi pedido</a>
        </div>
        <figure class="plate">
          <img src="/img/fachada.jpg" width="387" height="258" alt="Fachada de Carnicería Claudio de noche, con el cartel azul iluminado sobre la puerta" />
          <figcaption>Vieytes y Alfaro, con el cartel prendido hasta la noche</figcaption>
        </figure>
        <dl class="rows">
          {rows.map((r) => (
            <div>
              <dt>{r.label}</dt>
              <dd>{r.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <p class="thanks">Gracias por su compra</p>
    </article>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding: clamp(1rem, 2.5vw, 2rem) var(--margin) clamp(3rem, 7vw, 6rem);
    background: var(--blue);
    display: grid;
    align-content: start;
    justify-items: center;
  }
  /* La boca de la balanza de la que sale el ticket. */
  .slot {
    width: min(100%, 76rem);
    height: 14px;
    background: var(--blue-deep);
    position: relative;
    z-index: 2;
  }
  .feed {
    width: min(100% - 24px, 74rem);
    overflow: hidden;
    margin-top: -4px;
  }
  .ticket {
    background: var(--paper);
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.25rem, 4vw, 3.5rem) clamp(1.75rem, 3vw, 2.5rem);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ticket { animation: print 1400ms var(--ease-out) both; }
    .plate img { animation: settle 2200ms var(--ease-out) both; }
  }
  @keyframes print { from { transform: translateY(-101%); } to { transform: none; } }
  @keyframes settle { from { transform: scale(1.12); } to { transform: none; } }

  .top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .logo { width: clamp(64px, 8vw, 96px); height: auto; }
  nav { display: none; gap: clamp(1rem, 2.4vw, 2rem); font-weight: 600; }
  nav a { text-decoration: none; padding-block: 0.5rem; transition: color var(--t-hover) ease; }
  @media (hover: hover) and (pointer: fine) { nav a:hover { color: var(--red); } }

  .body {
    display: grid;
    grid-template-areas: 'title' 'statement' 'rows' 'actions' 'plate';
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  h1 { grid-area: title; font-size: clamp(3.4rem, 1rem + 9.5vw, 8.25rem); }
  .statement { grid-area: statement; font-size: var(--step-lead); line-height: 1.3; max-width: 30ch; }

  .rows { grid-area: rows; display: grid; }
  .rows div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0.85rem; }
  .rows div:nth-child(odd) { background: var(--paper-2); }
  dt { color: var(--muted); }
  dd { font-weight: 600; text-align: right; }

  .actions { grid-area: actions; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .actions .btn { flex: 1 1 100%; }

  .plate { grid-area: plate; }
  .plate div, .plate { overflow: hidden; }
  .plate img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; object-position: top; }
  .plate figcaption { font-size: var(--step-small); color: var(--muted); margin-top: 0.6rem; }

  .thanks { text-align: center; font-size: var(--step-small); color: var(--muted); margin: clamp(2rem, 4vw, 3rem) auto 0; }

  @media (min-width: 48rem) {
    nav { display: flex; }
    .actions .btn { flex: 0 0 auto; }
  }
  @media (min-width: 64rem) {
    .body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas: 'title plate' 'statement rows' 'actions rows';
      column-gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }
    .actions { align-self: end; }
  }
</style>
